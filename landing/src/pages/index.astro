---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Loop from '../components/Loop.astro';
import Level from '../components/Level.astro';
import Reliability from '../components/Reliability.astro';
import Neighbourhood from '../components/Neighbourhood.astro';
import Price from '../components/Price.astro';
import Faq from '../components/Faq.astro';
import CloseCta from '../components/CloseCta.astro';
import Footer from '../components/Footer.astro';

const title = 'Socius — Senin gibi oynayanlarla tanış';
const description =
	"Padel, futbol, tenis ya da pazar koşusu. Seviyene göre eşleşen, sana on dakika mesafedeki oyunlar. İstanbul'da başlıyoruz.";
---

<Base title={title} description={description}>
	<Nav />
	<main id="icerik">
		<Hero />
		<Problem />
		<Loop />
		<Level />
		<Reliability />
		<Neighbourhood />
		<Price />
		<Faq />
		<CloseCta />
	</main>
	<Footer />
</Base>
